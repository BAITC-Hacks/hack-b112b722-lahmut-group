# No OpenAI or NVIDIA hosted API key required for meeting processing.
DATA_DIR=./data
# .env is loaded automatically; environment variables take precedence.
# Start one backend process: python -m backend (loopback port 8000).
# On GPU: run backend and Ollama there; access via SSH port forwarding.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
ASR_MODEL=large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# Download models separately before offline processing.
DIARIZATION_MODEL_PATH=
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=


# No OpenAI or NVIDIA hosted API key required for meeting processing.
DATA_DIR=./data
# .env is loaded automatically; environment variables take precedence.
# Start one backend process: python -m backend (loopback port 8000).
# On GPU: run backend and Ollama there; access via SSH port forwarding.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:32b
OLLAMA_THINKING=false
ASR_MODEL=models/gpu/asr
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=int8_float16
# Tested optional recovery of speech-covered ASR gaps; adds a review warning.
ASR_GAP_RECOVERY=true
# Download models separately before offline processing.
DIARIZATION_MODEL_PATH=models/gpu/diarization
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=

# Optional external notification channel; false keeps the application offline.
# Create a bot with @BotFather; place its token only in .env/environment.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# false: neutral messages with task reference. true: send task text + deadline.
# Enable task text only for explicitly permitted data (e.g. fictional demo).
TELEGRAM_INCLUDE_TASK_TEXT=false
